# Publish source files only. Add a rule here for new project files.
*
!/.gitignore
!/.gitattributes
!/README.md
!/package.json
!/package-lock.json
!/server.mjs
!/photos.mjs
!/stock-photos.mjs
!/rooms.mjs
!/room-results.mjs
!/remote-access.mjs
!/remote-gateway.mjs
!/launch.ps1
!/stop.ps1
!/start.cmd
!/start-online.cmd
!/stop.cmd
!/setup-tuna.cmd
!/manage-tuna.cmd
!/public/
!/public/app.js
!/public/index.html
!/public/style.css
!/public/group.js
!/public/group.html
!/public/group.css
!/public/favicon.svg
!/tests/
!/tests/*.test.mjs

# Keep personal data and generated files local, even in source folders.
**/data/
**/work/
**/bin/
**/node_modules/
**/.env*
*.log
*.pem
*.key
